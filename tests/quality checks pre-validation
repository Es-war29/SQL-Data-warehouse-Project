
--------------------PRE-validation------------------------


-- checks for table bronze.crm_cst_info

-- check for duplicate values in primary key 

select 
    cst_id, count(*) duplicates
from bronze.crm_cst_info
group by cst_id
having duplicates > 1 or cst_id IS NULL;


-- check and remove unwanted spaces

select
    cst_first_name,
    cst_lastname
from bronze.crm_cst_info
where cst_first_name != trim(cst_first_name)
and cst_lastname != trim(cst_lastname);


-- data standardization and consistency
-- Removing abbreviations in gender and marital status

select distinct cst_gndr  from bronze.crm_cst_info;
select distinct cst_material_status  from bronze.crm_cst_info;


