-- checks for table bronze.crm_sales_info

--check unwanted spaces

select
    *
from bronze.crm_sales_info
where sls_ord_num != trim(sls_ord_num);

-- check if any  sls_prd_key doesn't match with other table value

select * from bronze.crm_sales_info
where sls_prd_key NOT IN (select prd_key from silver.crm_prd_info);

-- check if any  sls_cust_id doesn't match with other table value

select * from bronze.crm_sales_info
where sls_cust_id NOT IN (select cst_id from silver.crm_cst_info);

-- checks the invalid dates

select 
    sls_order_dt,sls_ship_dt,sls_due_dt
from bronze.crm_sales_info
where sls_order_dt <=0 
or len(sls_order_dt) !=8 
or sls_order_dt >20500101 
or sls_order_dt <19000101;

-- check invalid date orders

select 
    sls_order_dt,sls_ship_dt,sls_due_dt
from bronze.crm_sales_info
where sls_order_dt > sls_ship_dt or sls_order_dt > sls_due_dt;


-- check data consistency: between sales, quantity, and price
-- >> slaes = quantity * price
-- >> Values must not be null, zeros, or negative


select distinct
    sls_sales,
    sls_quantity,
    sls_price
from bronze.crm_sales_info
where sls_sales != sls_quantity * sls_price
or sls_sales is null or sls_quantity is null or sls_price is null
or sls_sales <= 0 or  sls_quantity <= 0 or  sls_price <= 0
order by sls_sales,sls_quantity,sls_price;

