--------------------------- Silver Layer Transformation ---------------------------------

-- 1. for the table silver.crm_cst_info
--removing duplicate values and nulls

select * from (
select 
    *, row_number() over(partition by cst_id order by cst_create_date desc) as flag
from bronze.crm_cst_info
--where cst_id = 29466;
)t where flag = 1 and cst_id = 29466;

-- removing unwanted spaces

Select *,
        trim(cst_first_name) cst_first_name,
        trim(cst_lastname) cst_lastname,
from bronze.crm_cst_info;

-- data standardization and consistency
-- Removing abbreviations in gender and marital status

select 
    case upper(trim(cst_gndr))
        when 'F' then 'Female'
        when 'M' then 'Male'
        else 'N/A'
    end cst_gndr,
    case upper(trim(cst_material_status))
        when 'M' then 'Married'
        when 'S' then 'Single'
        else 'N/A'
    end cst_material_status
from bronze.crm_cst_info;

-- final query after cleaning the nulls, duplicates, and extra spaces, removing abbreviations

select 
    cst_id,cst_key,
    trim(cst_first_name) cst_first_name,
    trim(cst_lastname) cst_lastname,
    case upper(trim(cst_material_status))
        when 'M' then 'Married'
        when 'S' then 'Single'
        else 'N/A'
    end cst_material_status,
    case upper(trim(cst_gndr))
        when 'F' then 'Female'
        when 'M' then 'Male'
        else 'N/A'
    end cst_gndr,
    cst_create_date
from (
select 
    *, row_number() over(partition by cst_id order by cst_create_date desc) as flag
from bronze.crm_cst_info
where cst_id is not null
)t where flag = 1;


