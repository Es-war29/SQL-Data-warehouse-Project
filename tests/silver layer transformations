-- 4. for the table silver.erp_cst_az12

-- removing the unwanted characters 

select 
    cid,
    case when cid like 'NAS%' then substr(cid,4,len(cid))
         else cid 
    end cid
from bronze.erp_cst_az12
where cid not in (select cst_key from silver.crm_cst_info);

-- In-corredct bdate

select 
    bdate,
    case when bdate > current_date() then NULL
         else bdate
    end bdate
from bronze.erp_cst_az12
where bdate > current_date();

-- data standarization & consistency

select 
    gen,
    case 
        when upper(trim(gen)) IN ('M','Male') then 'Male'
        when upper(trim(gen)) IN ('F','Female') then 'Female'
        else 'N/A'
    end gen
from bronze.erp_cst_az12;

-- final query after removing unwanted characters, cleaning birthdate, removing abbrevations

select 
    case when cid like 'NAS%' then substr(cid,4,len(cid))
         else cid 
    end cid,
    case when bdate > current_date() then NULL
         else bdate
    end bdate,
    case 
        when upper(trim(gen)) IN ('M','Male') then 'Male'
        when upper(trim(gen)) IN ('F','Female') then 'Female'
        else 'N/A'
    end gen
from bronze.erp_cst_az12;
