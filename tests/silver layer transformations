-- 2. for the table silver.crm_prd_info

-- splitting the row prd_key to form cat_id
select prd_key,
    replace(substr(prd_key,1,5),'-','_') cat_id,
    substr(prd_key,7,len(prd_key)) as prd_key
from bronze.crm_prd_info;

-- Remove nulls and negative values
select 
    IFNULL(prd_cost,0) prd_cost
from bronze.crm_prd_info;

-- data standardization and consistency
-- Removing abbreviations in gender and marital status

select 
    case upper(trim(prd_line))
        when 'M' then 'Mountain'
        when 'R' then 'Road'
        when 'S' then 'Other Sales'
        when 'T' then 'Touring'
        else 'N/A'
    end prd_line
from bronze.crm_prd_info;

-- removing invalid date records
select 
    *,
    cast(dateadd('day', -1, lead(prd_start_dt) over(partition by prd_key order by prd_start_dt asc)) as DATE) prd_end_dt_test
from bronze.crm_prd_info
where prd_key in ('AC-HE-HL-U509-R','AC-HE-HL-U509');

-- final query after creating new columns from prd_key, removing null values, removing abbreviations, and removing invalid dates

select prd_id,
    prd_key,
    replace(substr(prd_key,1,5),'-','_') cat_id,
    substr(prd_key,7,len(prd_key)) as prd_key,
    IFNULL(prd_cost,0) prd_cost,
    case upper(trim(prd_line))
        when 'M' then 'Mountain'
        when 'R' then 'Road'
        when 'S' then 'Other Sales'
        when 'T' then 'Touring'
        else 'N/A'
    end prd_line,
    cast(prd_start_dt as DATE) prd_start_dt,
    cast(dateadd('day', -1, lead(prd_start_dt) over(partition by prd_key order by prd_start_dt asc)) as DATE) prd_end_dt
from bronze.crm_prd_info;

