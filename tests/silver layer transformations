-- 3. for the table silver.crm_sales_info

-- removing zeros from date 

select 
    --NULLIF(sls_order_dt,0) sls_order_dt,
    case 
        when sls_order_dt=0 or len(sls_order_dt) !=8  then NULL
        else cast(cast(sls_order_dt as varchar) as DATE)
    end sls_order_dt,
    case 
        when sls_ship_dt =0 or len(sls_ship_dt) !=8  then NULL
        else cast(cast(sls_ship_dt as varchar) as DATE)
    end sls_ship_dt,
    case 
        when sls_due_dt=0 or len(sls_due_dt) !=8  then NULL
        else cast(cast(sls_due_dt as varchar) as DATE)
    end sls_due_dt
from bronze.crm_sales_info;

-- transforming  data consistency: between sales, quantity, and price
-- >> slaes = quantity * price
-- >> Values must not be null, zeros, or negative

select 
    sls_sales,
    sls_quantity,
    sls_price,
    case when sls_sales IS NULL or sls_sales <=0 or sls_sales != sls_quantity *ABS(sls_price)
            then sls_quantity *ABS(sls_price)
         else sls_sales
    end sls_sales,
    sls_quantity,
    case when sls_price is NULL or sls_price <= 0 then sls_sales/NULLIF(sls_quantity,0)
        else sls_price
    end sls_price
    from bronze.crm_sales_info
where sls_sales != sls_quantity * sls_price or sls_sales IS NULL;

-- final query after removing zeros,type casting to date, transforming data inconsistency

select 
    sls_ord_num,
    sls_prd_key,
    sls_cust_id,
    case 
        when sls_order_dt=0 or len(sls_order_dt) !=8  then NULL
        else cast(cast(sls_order_dt as varchar) as DATE)
    end sls_order_dt,
    case 
        when sls_ship_dt =0 or len(sls_ship_dt) !=8  then NULL
        else cast(cast(sls_ship_dt as varchar) as DATE)
    end sls_ship_dt,
    case 
        when sls_due_dt=0 or len(sls_due_dt) !=8  then NULL
        else cast(cast(sls_due_dt as varchar) as DATE)
    end sls_due_dt,
    case when sls_sales IS NULL or sls_sales <=0 or sls_sales != sls_quantity *ABS(sls_price)
            then sls_quantity *ABS(sls_price)
         else sls_sales
    end sls_sales,
    sls_quantity,
    case when sls_price is NULL or sls_price <= 0 then sls_sales/NULLIF(sls_quantity,0)
        else sls_price
    end round(sls_price,0) sls_price
safrom bronze.crm_sales_info;

