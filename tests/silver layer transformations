-- 5. for the table silver.erp_loc_a101

-- removing the unwanted charcter in cid

select 
    cid,
    replace(cid,'-','') cid
from bronze.erp_loc_a101;

-- Data Standarization and consistency

select 
    distinct cntry,
    case when upper(trim(cntry)) IN ('USA','US') then 'United States'
         when upper(trim(cntry)) IN('DE') then 'Germany'
         when trim(cntry) = '' or cntry is null then 'N/A'
         else trim(cntry)
    end cntry
from bronze.erp_loc_a101;

-- final query after removing unwanted character and data normalization

select 
    replace(cid,'-','') cid,
    case when upper(trim(cntry)) IN ('USA','US') then 'United States'
         when upper(trim(cntry)) IN('DE') then 'Germany'
         when trim(cntry) = '' or cntry is null then 'N/A'
         else trim(cntry)
    end cntry
from bronze.erp_loc_a101;
